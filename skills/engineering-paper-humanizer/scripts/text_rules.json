            "severity": "info",
            "pattern": "(?:在很大的程度上|在很大程度上)",
            "message": "检测到填充限定短语",
            "fix": "直接删除或给出具体程度",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-036b",
            "severity": "info",
            "pattern": "(?:必须提到的一点是|值得一提的是)",
            "message": "检测到 AI 填充短语（it must be noted that）",
