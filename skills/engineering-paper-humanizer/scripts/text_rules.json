{
    "rules": [
        {
            "id": "PUNCT-001",
            "severity": "error",
            "pattern": "(?<![\\\\])\"[^\"]*\"",
            "message": "检测到 ASCII 直双引号，中文正文通常不得使用 \"...\"",
            "fix": "按语境处理：中文引用/术语用“...”，嵌套引用用‘...’，书名/论文名/标准名用《...》，代码/命令/变量/路径用反引号或 LaTeX 等宽命令；英文整句引用在 LaTeX 中优先使用 TeX 式引号或 \\enquote{}",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "PUNCT-002",
            "severity": "warning",
            "pattern": "——|—|–|(?<!\\d)-{2,3}(?!\\d)",
            "message": "检测到破折号或异常 dash，学术正文中通常暴露 AI 式解释/转折",
            "fix": "解释关系改为“即/也就是说”或拆句；补充插入改为逗号/括号；强转折改为分号/句号。数字范围、页码范围、数学负号、复合术语和代码除外",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "PUNCT-003",
            "severity": "warning",
            "pattern": "[）)]\\s*[（(]",
            "message": "检测到连续括号堆砌",
            "fix": "合并括号内容或将解释化入正文",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-001",
            "severity": "info",
            "pattern": "本[章节]将(?:针对|详细|主要|重点)",
            "message": "检测到章节预告句式（AIGC 高频特征）",
            "fix": "删除预告，用客观主语自然过渡",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-002",
            "severity": "info",
            "pattern": "(?:具有|拥有)(?:十分|非常|极其)?重要的(?:工程|理论|实际|现实)(?:应用)?(?:价值|意义)",
            "message": "检测到空泛价值声明（AIGC 高频特征）",
            "fix": "删除或改为具体学术贡献描述",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-003",
            "severity": "info",
            "pattern": "(?:突破|攻克)了?.*?(?:技术瓶颈|关键难题)",
            "message": "检测到 AI 敏感词组“突破技术瓶颈”",
            "fix": "替换为“克服...技术难点”或“提出了...解决方案”，避免夸大和套话",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-004",
            "severity": "info",
            "pattern": "(?:提供|奠定)了?.*?(?:理论|数据|技术)(?:支撑|支持|基础)",
            "message": "检测到 AI 升华结尾“提供数据支撑”",
            "fix": "删除升华句，陈述完技术事实即结束段落",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-005",
            "severity": "info",
            "pattern": "(?:虽然|尽管).*?(?:取得了|已经|已有).*?(?:但是?|然而|不过).*?(?:仍然?|依然|尚)",
            "message": "检测到“虽然...但仍...”模板句（AIGC 高频模式）",
            "fix": "直接客观陈述双方侧重点",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-006",
            "severity": "info",
            "pattern": "应运而生",
            "message": "检测到 AI 敏感词“应运而生”",
            "fix": "直接删除",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-007",
            "severity": "info",
            "pattern": "双重困境",
            "message": "检测到 AI 敏感词“双重困境”",
            "fix": "替换为“双重问题”或“局限性”",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-008",
            "severity": "info",
            "pattern": "旨在(?:解决|探讨|研究)",
            "message": "检测到 AI 敏感词“旨在解决/探讨”",
            "fix": "替换为“致力于改善”或“深入分析了”",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-009",
            "severity": "info",
            "pattern": "(?:行业报告|观察者|专家|一些批评者|多个来源)(?:显示|指出|认为|表明)",
            "message": "检测到模糊归因（应引用具体文献）",
            "fix": "替换为具体学者姓名+\\cite{xxx}引用",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-010",
            "severity": "warning",
            "pattern": "(?:希望这(?:些信息)?对您有帮助|请告诉我|您说得[完全]*正确|当然！|一定！)",
            "message": "检测到 AI 协作交流残留文本",
            "fix": "删除协作交流痕迹",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-011",
            "severity": "warning",
            "pattern": "(?:截至目前|截至写作时|根据我最后的|虽然具体细节有限|基于可用信息)",
            "message": "检测到 AI 知识截止免责声明残留",
            "fix": "删除免责声明，补充具体文献引用",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-012",
            "severity": "info",
            "pattern": "(?:不仅仅是|这不仅仅是关于)",
            "message": "检测到否定式排比（AI 高频模式）",
            "fix": "删除否定式排比，直接陈述",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-013",
            "severity": "info",
            "pattern": "(?:未来看起来光明|激动人心的时代|追求卓越的旅程|向正确方向迈出)",
            "message": "检测到通用积极结论（AI 套话）",
            "fix": "删除套话，改为具体规划或直接删除",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-014",
            "severity": "info",
            "pattern": "可以潜在地(?:可能)?(?:被认为)?",
            "message": "检测到过度限定表达",
            "fix": "简化为直接陈述",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-014a",
            "severity": "info",
            "pattern": "(?:为了实现这一点|由于下雨的事实|在这个时间点|在您需要帮助的情况下|系统具有处理的能力|值得注意的是数据显示)",
            "message": "检测到 Humanizer-zh 填充短语",
            "fix": "简化：为了实现这一点→因此/为此；由于...事实→因为；在这个时间点→目前/此时；在...情况下→若/当；系统具有...能力→系统可以；值得注意的是数据显示→数据显示",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-015",
            "severity": "info",
            "pattern": "彻底解决",
            "message": "检测到绝对化词汇“彻底解决”",
            "fix": "降级为“有效改善”或“有效降低”",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-016",
            "severity": "info",
            "pattern": "(?:现有研究|已有研究|相关研究)(?:表明|显示|证明|指出)",
            "message": "检测到模糊文献综述起手式",
            "fix": "替换为具体学者引用（如“张某等\\cite{xxx}指出”）",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-017",
            "severity": "info",
            "pattern": "国内(?:外)?起步较晚",
            "message": "检测到 AI 文献综述套话“国内起步较晚”",
            "fix": "删除，直接陈述“近年来，国内学者围绕XXX展开了针对性研究”",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-018",
            "severity": "info",
            "pattern": "(?:众所周知|业内公认|普遍认为)",
            "message": "检测到虚假权威/模糊归因",
            "fix": "必须精确到具体参考文献编号或作者姓名",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-019",
            "severity": "info",
            "pattern": "(?:权威专家|大量实验)(?:建议|证明|表明)",
            "message": "检测到虚假权威声明",
            "fix": "删除或替换为具体实验数据+文献引用",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-019a",
            "severity": "info",
            "pattern": "(?: hailed\\s+as|acknowledged\\s+for|renowned\\s+for)",
            "message": "检测到英文宣传性表述（AI 常用套话）",
            "fix": "替换为平实英文描述",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-020",
            "severity": "warning",
            "pattern": "(?:让我们来看|好问题|正如您所指出|非常准确地描述)",
            "message": "检测到 AI 对话口癖残留",
            "fix": "彻底删除",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-021",
            "severity": "info",
            "pattern": "(?:在某种程度上|在很大范围内|在一定程度上)",
            "message": "检测到虚假范围限定词",
            "fix": "删除或给出具体数值/工况区间",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-022",
            "severity": "info",
            "pattern": "(?:实现着|体现着|推动着|引领着|展现着)",
            "message": "检测到虚假“着”字深度句式（模仿英文-ing）",
            "fix": "改为直接动词陈述（“实现了”/“体现了”）",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-023",
            "severity": "info",
            "pattern": "(?:可以说|基本上(?:可以)?说?)",
            "message": "检测到填充限定词",
            "fix": "删除，工程结论应当是确定性的",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-024",
            "severity": "info",
            "pattern": "具有广阔的(?:应用|发展)?前景",
            "message": "检测到通用积极结尾套话",
            "fix": "删除或改为具体技术规划",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-025",
            "severity": "info",
            "pattern": "协同难题",
            "message": "检测到 AI 敏感词“协同难题”",
            "fix": "替换为“协同障碍”或“控制挑战”",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-026",
            "severity": "info",
            "pattern": "取得了一定(?:的)?进展",
            "message": "检测到 AI 模糊成果表述",
            "fix": "替换为具体科研动作（如“提出了基于XX的算法”）",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-027",
            "severity": "info",
            "pattern": "(?:从而实现|以期(?:实现|达到)?)",
