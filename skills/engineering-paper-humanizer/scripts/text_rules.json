        },
        {
            "id": "AIGC-029",
            "severity": "info",
            "pattern": "(?:不断演变|不断发展)的",
            "message": "检测到 AI 高频修饰语",
            "fix": "删除或改为具体变化描述",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-030",
            "severity": "info",
            "pattern": "为了实现这一目标",
