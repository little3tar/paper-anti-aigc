                "latex",
                "markdown",
                "plain"
            ]
        },
        {
            "id": "AIGC-035",
            "severity": "info",
            "pattern": "似乎(?:可以|能够|表明)",
            "message": "检测到过度限定词“似乎”",
            "fix": "删除，工程结论应当是确定性的",
            "format": [
                "latex",
                "markdown",
                "plain"
            ]
