#!/usr/bin/env python3
"""SessionStart 钩子：扫描 .thesis-workflow/chapters/ch*/status.json，注入工作流状态提示。

在每次新会话启动时运行，让 AI 知道当前论文工作流各章进度和下一步该做什么。
"""

import json
import os
import sys

from _win_compat import setup_windows_utf8
setup_windows_utf8()

FILE_SAFETY = (
    "主文件保护（PreToolUse 钩子强制）：草稿写入 .thesis-workflow/chapters/chX/draft.md，"
    "不要直接写入主文件。主文件只在全部五个阶段完成、用户显式确认后才可修改。"
)

STAGE_GUIDES = {
    "fix-evidence": (
        "第{ch}章: P0={p0}, P1={p1} 未清零，next_allowed=fix-evidence。"
        "只能运行 reference-integrity-auditor 修复证据问题。"
        "禁止运行 engineering-paper-humanizer 和 academic-format-cleaner。"
    ),
    "humanizer": (
        "第{ch}章: P0/P1 已清零，next_allowed=humanizer。"
        "可以运行 engineering-paper-humanizer 润色正文。"
    ),
    "format-cleaner": (
        "第{ch}章: 润色已完成，next_allowed=format-cleaner。"
        "可以运行 academic-format-cleaner 进行格式收尾。"
    ),
    "next-chapter": (
        "第{ch}章: 全部五个阶段已完成，next_allowed=next-chapter。"
    ),
}


def find_workflow_dir() -> str | None:
    cwd = os.getcwd()
    path = cwd
    while True:
        candidate = os.path.join(path, ".thesis-workflow")
        if os.path.isdir(candidate):
            return candidate
        parent = os.path.dirname(path)
        if parent == path:
            break
        path = parent
    return None


def build_context(workflow_dir: str) -> str:
    chapters_dir = os.path.join(workflow_dir, "chapters")

    # 扫描各章 status.json
    chapter_statuses = {}
    if os.path.isdir(chapters_dir):
        for entry in os.listdir(chapters_dir):
            ch_dir = os.path.join(chapters_dir, entry)
            if not os.path.isdir(ch_dir) or not entry.startswith("ch"):
                continue
            status_path = os.path.join(ch_dir, "status.json")
            if os.path.isfile(status_path):
                try:
                    with open(status_path, "r", encoding="utf-8") as f:
                        chapter_statuses[entry] = json.load(f)
                except (json.JSONDecodeError, OSError):
                    pass

    if not chapter_statuses:
        return _default_context()

    # 构建各章状态摘要
    lines = ["论文工作流各章状态："]
    active_chapter = None
    for ch_name in sorted(chapter_statuses.keys()):
        s = chapter_statuses[ch_name]
        na = s.get("next_allowed", "?")
        p0 = s.get("p0_count", "?")
        p1 = s.get("p1_count", "?")
        p2 = s.get("p2_count", "?")
        stage = s.get("stage", "?")
        lines.append(
            f"  {ch_name}: stage={stage}, P0={p0}, P1={p1}, P2={p2}, next={na}"
        )
        if na not in ("next-chapter",):
            active_chapter = ch_name

    # 若无活跃章节（所有章 next_allowed 均为 next-chapter），在已有章的最大编号 + 1 处预测
    if active_chapter is None:
        existing_nums = [int(k.replace("ch", "")) for k in chapter_statuses.keys() if k.startswith("ch")]
        next_num = max(existing_nums) + 1 if existing_nums else 1
        active_chapter = f"ch{next_num}"

    # 为活跃章节生成引导
    guide = ""
    if active_chapter and active_chapter in chapter_statuses:
        s = chapter_statuses[active_chapter]
        na = s.get("next_allowed", "")
        template = STAGE_GUIDES.get(na)
        if template:
            guide = template.format(
                ch=active_chapter,
                p0=s.get("p0_count", "?"),
                p1=s.get("p1_count", "?"),
            )
    elif active_chapter:
        guide = f"下一章 {active_chapter} 尚未开始，可进入大纲规划或细纲设计。"

    summary = "\n".join(lines)
    return f"{summary}\n{guide}\n{FILE_SAFETY}"


def _default_context() -> str:
    return (
        "论文写作技能已就绪。五个阶段：thesis-outline-planner → "
        "evidence-grounded-chapter-writer → reference-integrity-auditor → "
        "engineering-paper-humanizer → academic-format-cleaner。"
        "默认按顺序执行全部五步。用户明确指定\"只运行X\"时才允许局部执行。\n"
        + FILE_SAFETY
    )


def main():
    workflow_dir = find_workflow_dir()
    if workflow_dir:
        context = build_context(workflow_dir)
    else:
        context = _default_context()

    output = {
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": context,
        }
    }
    print(json.dumps(output, ensure_ascii=False))


if __name__ == "__main__":
    main()
