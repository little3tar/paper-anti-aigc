#!/usr/bin/env python3
"""SessionStart 钩子：检测 .thesis-workflow/status.json，注入工作流状态提示。

在每次新会话启动时运行，让 AI 知道当前论文工作流处于哪个阶段、下一步该做什么。
"""

import json
import os
import sys

if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")

FILE_SAFETY = (
    "主文件保护（PreToolUse 钩子强制）：草稿写入 .thesis-workflow/chapters/chX/draft.md，"
    "不要直接写入主文件。主文件只在全部五个阶段完成、用户显式确认后才可修改。"
)

STAGE_GUIDES = {
    "fix-evidence": (
        "当前状态: P0={p0}, P1={p1} 未清零，next_allowed=fix-evidence。"
        "你只能运行 reference-integrity-auditor 修复证据问题。"
        "禁止运行 engineering-paper-humanizer 和 academic-format-cleaner。禁止开始下一章。"
    ),
    "humanizer": (
        "当前状态: P0/P1 已清零，next_allowed=humanizer。"
        "你可以运行 engineering-paper-humanizer 润色正文，然后运行 academic-format-cleaner 格式收尾。"
        "润色后文本写入 main-chX.md/main-chX.txt/main-chX.tex，阶段产物 chapters/chX/humanized.md、chapters/chX/format-cleaned.md 只存操作记录（变更清单），不存全文副本。"
    ),
    "format-cleaner": (
        "当前状态: 润色已完成，next_allowed=format-cleaner。"
        "你可以运行 academic-format-cleaner 进行格式收尾。"
    ),
    "next-chapter": (
        "当前状态: 本章全部五个阶段已完成，next_allowed=next-chapter。"
        "可以进入下一章的大纲规划或细纲设计。"
    ),
}


def find_workflow_dir() -> str | None:
    cwd = os.getcwd()
    # 向上遍历查找 .thesis-workflow/
    path = cwd
    while True:
        candidate = os.path.join(path, ".thesis-workflow")
        if os.path.isdir(candidate):
            return candidate
        parent = os.path.dirname(path)
        if parent == path:
            break
        path = parent
    return None


def build_context(workflow_dir: str) -> str:
    status_path = os.path.join(workflow_dir, "status.json")
    if not os.path.isfile(status_path):
        return _default_context()

    try:
        with open(status_path, "r", encoding="utf-8") as f:
            status = json.load(f)
    except (json.JSONDecodeError, OSError):
        return _default_context()

    na = status.get("next_allowed", "unknown")
    p0 = status.get("p0_count", "?")
    p1 = status.get("p1_count", "?")

    guide_template = STAGE_GUIDES.get(na)
    if guide_template:
        stage_guide = guide_template.format(p0=p0, p1=p1)
    else:
        stage_guide = (
            f"当前状态: next_allowed={na}, P0={p0}, P1={p1}。"
            f"请先读取 status.json 确认当前阶段。"
        )

    status_str = json.dumps(status, ensure_ascii=False)
    return f"论文工作流状态：{status_str}。{stage_guide}。{FILE_SAFETY}"


def _default_context() -> str:
    return (
        "论文写作技能已就绪。五个阶段：thesis-outline-planner → "
        "evidence-grounded-chapter-writer → reference-integrity-auditor → "
        "engineering-paper-humanizer → academic-format-cleaner。"
        "默认按顺序执行全部五步。用户明确指定\"只运行X\"时才允许局部执行。"
        + FILE_SAFETY
    )


def main():
    workflow_dir = find_workflow_dir()
    if workflow_dir:
        context = build_context(workflow_dir)
    else:
        context = _default_context()

    output = {
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": context,
        }
    }
    print(json.dumps(output, ensure_ascii=False))


if __name__ == "__main__":
    main()
