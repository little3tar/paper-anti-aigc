#!/usr/bin/env python3
"""PreToolUse 钩子：论文工作流阶段门控。

四道防线：
1. 主文件保护 — 全部五阶段完成前禁止写入 main-ch*.md/txt/tex
2. 阶段门控 — P0/P1 未清零 + next_allowed 不匹配时禁止写入阶段产物
3. 跳阶段确认 — 缺少上游产物时要求用户确认（ask，非 deny）
4. 细纲确认阻塞 — 细纲未 confirmed 时禁止写入正文草稿

门控状态按章存储：读取 .thesis-workflow/chapters/chX/status.json。
"""

import json
import os
import re
import sys

from _win_compat import setup_windows_utf8
setup_windows_utf8()
from pathlib import Path


def find_workflow_dir() -> Path | None:
    cwd = Path.cwd()
    for parent in [cwd, *cwd.parents]:
        candidate = parent / ".thesis-workflow"
        if candidate.is_dir():
            return candidate
    return None


def extract_chapter(file_path: str) -> str | None:
    """从文件路径中提取章号。支持 chapters/ch4/xxx.md 和 main-ch4.md 两种格式。"""
    # chapters/ch4/xxx.md → ch4
    m = re.search(r"chapters/(ch\d+)/", file_path)
    if m:
        return m.group(1)
    # main-ch4.md → ch4
    m = re.search(r"main-(ch\d+)\.(?:md|txt|tex)$", os.path.basename(file_path))
    if m:
        return m.group(1)
    return None


def read_status(workflow_dir: Path, file_path: str = "") -> dict | None:
    """读取目标章的 status.json。"""
    ch = extract_chapter(file_path)
    if ch:
        ch_path = workflow_dir / "chapters" / ch / "status.json"
        if ch_path.is_file():
            try:
                return json.loads(ch_path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                pass
    return None


def get_protected_main_files(workflow_dir: Path) -> set[str]:
    """生成主文件保护名单。覆盖按章拆分模式（main-ch*.md/txt/tex）。"""
    main_files: set[str] = set()
    for i in range(1, 20):
        for ext in (".md", ".txt", ".tex"):
            main_files.add(f"main-ch{i}{ext}")
    ctx_path = workflow_dir / "main-tex-context.md"
    if ctx_path.is_file():
        try:
            text = ctx_path.read_text(encoding="utf-8")
            for line in text.splitlines():
                s = line.strip()
                if s.startswith("主文件:") or s.lower().startswith("main file:"):
                    p = s.split(":", 1)[1].strip()
                    if p:
                        main_files.add(p)
                m = re.search(r"`([^`]+\.(?:tex|md|txt))`", s)
                if m:
                    main_files.add(m.group(1))
        except OSError:
            pass
    return main_files


def is_main_thesis_file(file_path: str, workflow_dir: Path) -> bool:
    if "/.thesis-workflow/" in file_path or file_path.startswith(".thesis-workflow"):
        return False
    if "/skills/" in file_path:
        return False
    fname = os.path.basename(file_path)
    main_names = get_protected_main_files(workflow_dir)
    if fname in main_names:
        return True
    for ext in (".md", ".txt", ".tex"):
        if fname.startswith("main-ch") and fname.endswith(ext):
            return True
    return False


def is_stage_product(file_path: str, stage: str) -> bool:
    """检查文件路径是否匹配指定阶段的产物。"""
    products_new = {
        "02": re.compile(r"chapters/ch\d+/draft\.md$"),
        "03": re.compile(r"chapters/ch\d+/audit\.md$"),
        "04": re.compile(r"chapters/ch\d+/humanized\.md$"),
        "05": re.compile(r"chapters/ch\d+/format-cleaned\.md$"),
    }
    pattern = products_new.get(stage)
    if pattern and pattern.search(file_path):
        return True
    return False


def upstream_exists(workflow_dir: Path, file_path: str, upstream_pattern: str) -> bool:
    """检查上游产物是否存在。upstream_pattern 中的 chX 替换为目标章的章号。"""
    ch = extract_chapter(file_path)
    if ch:
        resolved = upstream_pattern.replace("ch*", ch)
        return (workflow_dir / resolved).is_file()
    return False


def make_deny(reason: str) -> dict:
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        },
    }


def make_ask(reason: str) -> dict:
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "ask",
            "permissionDecisionReason": reason,
        },
    }


# ═══════════════════════════════════════════════════════════════════════════════
# 防线
# ═══════════════════════════════════════════════════════════════════════════════


def check_main_file_protection(file_path: str, workflow_dir: Path, status: dict | None):
    """防线 1：主文件保护 — 阶段未完成禁止写入 main-ch*.md/txt/tex。"""
    if not is_main_thesis_file(file_path, workflow_dir):
        return None

    if status is None:
        return None

    na = status.get("next_allowed", "")
    p0 = status.get("p0_count", -1)
    p1 = status.get("p1_count", -1)

    if na == "next-chapter":
        return None

    ch = extract_chapter(file_path) or "?"
    reason = (
        f"第{ch}章工作流未完成全部五个阶段，禁止直接写入主文件 ({os.path.basename(file_path)})。"
        f"当前状态: next_allowed={na}, P0={p0}, P1={p1}。"
        f"草稿应写入 .thesis-workflow/chapters/{ch}/draft.md。"
        f"最终文本在全部阶段完成、用户显式确认后方可写入主文件。"
        f"详见 workflow §输出与文件安全 和 §阶段产物职责分离。"
    )
    return make_deny(reason)


def check_stage_gate(file_path: str, workflow_dir: Path, status: dict | None):
    """防线 2：阶段门控 — P0/P1 未清零 + next_allowed 不匹配时禁止写入阶段产物。"""
    if status is None:
        # status.json 不存在 → 审计未运行，阻断 humanizer 和 format-cleaner 产物写入
        if is_stage_product(file_path, "04") or is_stage_product(file_path, "05"):
            ch = extract_chapter(file_path) or "?"
            return make_deny(
                f"第{ch}章 status.json 不存在，说明审计阶段未运行。"
                f"请先运行 reference-integrity-auditor 完成证据审计，"
                f"审计通过后会自动创建 status.json。详见 workflow §强制串行规则。"
            )
        return None

    p0 = status.get("p0_count", -1)
    p1 = status.get("p1_count", -1)
    na = status.get("next_allowed", "")

    target = None
    if is_stage_product(file_path, "04"):
        target = ("04-humanized.md", ("humanizer", "format-cleaner", "next-chapter"))
    elif is_stage_product(file_path, "05"):
        target = ("05-format-cleaned.md", ("format-cleaner", "next-chapter"))

    if target is None:
        return None

    product_name, allowed_states = target

    if p0 > 0 or p1 > 0:
        return make_deny(
            f"P0/P1 未清零（P0={p0}, P1={p1}），禁止写入 {product_name}。"
            f"必须先运行 reference-integrity-auditor 补齐证据，"
            f"审计通过并清零后方可进入下游阶段。详见 workflow §审计退回修复闭环。"
        )

    if na not in allowed_states:
        return make_deny(
            f"当前 next_allowed=\"{na}\"，不允许写入 {product_name}。"
            f"该产物要求 next_allowed 为 {' / '.join(allowed_states)}。"
            f"请确认上游阶段已完成并更新了 chapters/chX/status.json。详见 workflow §强制串行规则。"
        )

    return None


def check_skip_stage_confirm(file_path: str, workflow_dir: Path):
    """防线 3：跳阶段确认 — 缺少上游产物时要求用户确认。"""
    ch = extract_chapter(file_path)
    if not ch:
        return None

    checks = [
        ("02", f"chapters/{ch}/draft.md", "outline.md",
         "thesis-outline-planner", "大纲规划"),
        ("03", f"chapters/{ch}/audit.md", f"chapters/{ch}/draft.md",
         "evidence-grounded-chapter-writer", "章节写作"),
        ("04", f"chapters/{ch}/humanized.md", f"chapters/{ch}/audit.md",
         "reference-integrity-auditor", "证据审计"),
        ("05", f"chapters/{ch}/format-cleaned.md", f"chapters/{ch}/humanized.md",
         "engineering-paper-humanizer", "润色"),
    ]

    for stage, product, upstream, skill, desc in checks:
        if is_stage_product(file_path, stage) and not (workflow_dir / upstream).is_file():
            return make_ask(
                f"你正要写入 {product}，但 {upstream} 不存在。"
                f"请确认：是否已通过 {skill} 完成{desc}？"
                f"若用户已直接指定范围可继续；若未完成，建议先运行上游阶段以便证据追踪和后续审计。"
            )

    return None


def check_detail_outline_gate(file_path: str, workflow_dir: Path) -> dict | None:
    """防线 4：细纲确认阻塞 — 细纲未确认时禁止写入正文草稿。

    对应 workflow §强制串行规则第8条。"""
    if not is_stage_product(file_path, "02"):
        return None

    ch = extract_chapter(file_path)
    if not ch:
        return None

    status_path = workflow_dir / "ledger" / "chapter-status.md"
    if not status_path.is_file():
        return None  # ledger 不存在，跳过检查（首次运行）

    try:
        text = status_path.read_text(encoding="utf-8")
    except OSError:
        return None

    for line in text.splitlines():
        # 加固表格解析：strip 首尾管道符及空白，取非空列
        stripped = line.strip()
        if not stripped.startswith("|"):
            continue
        cols = [c.strip() for c in stripped.strip("|").split("|")]
        # 期望格式：| 章节 | 大纲 | 细纲 | 草稿 | 审计 | 润色 | 格式 | 备注 |
        if len(cols) < 4:
            continue
        if cols[1] != ch:
            continue
        detail_outline = cols[3]  # 第3列（0-indexed）为细纲状态
        if detail_outline != "confirmed":
            return make_deny(
                f"第{ch}章细纲状态为 '{detail_outline}'（非 confirmed），"
                f"禁止写入正文草稿。请先在 evidence-grounded-chapter-writer 中"
                f"输出细纲并等待用户显式确认。详见 workflow §强制串行规则第8条。"
            )
        break

    return None


def main():
    try:
        raw = sys.stdin.read()
        data = json.loads(raw)
    except (json.JSONDecodeError, OSError):
        print("{}")
        return

    tool_name = data.get("tool_name", "")
    if tool_name not in ("Write", "Edit", "MultiEdit"):
        print("{}")
        return

    tool_input = data.get("tool_input", {})
    file_path = tool_input.get("file_path", "") or ""
    if not file_path:
        print("{}")
        return

    workflow_dir = find_workflow_dir()
    if workflow_dir is None:
        print("{}")
        return

    status = read_status(workflow_dir, file_path)

    # 防线 1：主文件保护
    result = check_main_file_protection(file_path, workflow_dir, status)
    if result is not None:
        print(json.dumps(result, ensure_ascii=False))
        return

    # 防线 2：阶段门控
    result = check_stage_gate(file_path, workflow_dir, status)
    if result is not None:
        print(json.dumps(result, ensure_ascii=False))
        return

    # 防线 3：跳阶段确认
    result = check_skip_stage_confirm(file_path, workflow_dir)
    if result is not None:
        print(json.dumps(result, ensure_ascii=False))
        return

    # 防线 4：细纲确认阻塞
    result = check_detail_outline_gate(file_path, workflow_dir)
    if result is not None:
        print(json.dumps(result, ensure_ascii=False))
        return

    print("{}")


if __name__ == "__main__":
    main()
