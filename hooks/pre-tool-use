#!/usr/bin/env python3
"""PreToolUse 钩子：论文工作流阶段门控。

三道防线：
1. 主文件保护 — 全部五阶段完成前禁止写入 main.md/txt/tex
2. 阶段门控 — P0/P1 未清零 + next_allowed 不匹配时禁止写入阶段产物
3. 跳阶段确认 — 缺少上游产物时要求用户确认（ask，非 deny）

设计要点：
- 所有 AI 需要看到的指引放在 permissionDecisionReason（AI 可见），
  不在 systemMessage（仅用户可见，AI 看不到 — GitHub issue #26423）。
- deny 用于硬性违规，ask 用于需要用户确认的边界情况。
"""

import json
import os
import sys

if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
from pathlib import Path


def find_workflow_dir() -> Path | None:
    cwd = Path.cwd()
    for parent in [cwd, *cwd.parents]:
        candidate = parent / ".thesis-workflow"
        if candidate.is_dir():
            return candidate
    return None


def read_status(workflow_dir: Path) -> dict | None:
    status_path = workflow_dir / "status.json"
    if not status_path.is_file():
        return None
    try:
        return json.loads(status_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return None


def read_main_file_path(workflow_dir: Path) -> set[str]:
    main_files: set[str] = set()
    for stem in ("main", "thesis", "dissertation", "paper"):
        for ext in (".md", ".txt", ".tex"):
            main_files.add(f"{stem}{ext}")
    ctx_path = workflow_dir / "main-tex-context.md"
    if ctx_path.is_file():
        try:
            import re
            text = ctx_path.read_text(encoding="utf-8")
            for line in text.splitlines():
                s = line.strip()
                if s.startswith("主文件:") or s.lower().startswith("main file:"):
                    p = s.split(":", 1)[1].strip()
                    if p:
                        main_files.add(p)
                m = re.search(r"`([^`]+\.(?:tex|md|txt))`", s)
                if m:
                    main_files.add(m.group(1))
        except OSError:
            pass
    return main_files


def is_main_thesis_file(file_path: str, workflow_dir: Path) -> bool:
    if "/.thesis-workflow/" in file_path or file_path.startswith(".thesis-workflow"):
        return False
    if "/skills/" in file_path:
        return False
    fname = os.path.basename(file_path)
    main_names = read_main_file_path(workflow_dir)
    if fname in main_names:
        return True
    for stem in ("main", "thesis", "dissertation", "paper"):
        for ext in (".md", ".txt", ".tex"):
            if fname == f"{stem}{ext}":
                return True
    return False


def is_stage_product(file_path: str, stage: str) -> bool:
    products = {
        "02": "02-chapter-draft.md",
        "03": "03-reference-audit.md",
        "04": "04-humanized.md",
        "05": "05-format-cleaned.md",
    }
    target = products.get(stage, "")
    return bool(target) and file_path.endswith(target)


def upstream_exists(workflow_dir: Path, filename: str) -> bool:
    return (workflow_dir / filename).is_file()


def make_deny(reason: str) -> dict:
    """硬性拒绝。reason 写入 permissionDecisionReason（AI 可见）。"""
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        },
    }


def make_ask(reason: str) -> dict:
    """要求用户确认。reason 写入 permissionDecisionReason（AI 和用户均可见）。"""
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "ask",
            "permissionDecisionReason": reason,
        },
    }


# ═══════════════════════════════════════════════════════════════════════════════
# 防线
# ═══════════════════════════════════════════════════════════════════════════════


def check_main_file_protection(file_path: str, workflow_dir: Path, status: dict | None):
    """防线 1：主文件保护 — 阶段未完成禁止写入 main.md/txt/tex。"""
    if not is_main_thesis_file(file_path, workflow_dir):
        return None

    if status is None:
        return None

    na = status.get("next_allowed", "")
    p0 = status.get("p0_count", -1)
    p1 = status.get("p1_count", -1)

    if na == "next-chapter":
        return None

    reason = (
        f"论文工作流未完成全部五个阶段，禁止直接写入主文件 ({os.path.basename(file_path)})。"
        f"当前状态: next_allowed={na}, P0={p0}, P1={p1}。"
        f"草稿应写入 .thesis-workflow/02-chapter-draft.md。"
        f"最终文本在全部阶段完成、用户显式确认后方可写入主文件。"
        f"详见 workflow §输出与文件安全 和 §阶段产物职责分离。"
    )
    return make_deny(reason)


def check_stage_gate(file_path: str, workflow_dir: Path, status: dict | None):
    """防线 2：阶段门控 — P0/P1 未清零 + next_allowed 不匹配时禁止写入阶段产物。

    覆盖 workflow §强制串行规则 第 5 条（humanizer P0/P1 检查）和第 6 条（format-cleaner next_allowed 检查）。
    """
    if status is None:
        return None

    p0 = status.get("p0_count", -1)
    p1 = status.get("p1_count", -1)
    na = status.get("next_allowed", "")

    # 确定目标阶段及其合法状态
    target = None  # (product_name, allowed_next_allowed_values)
    if is_stage_product(file_path, "04"):
        target = ("04-humanized.md", ("humanizer", "format-cleaner", "next-chapter"))
    elif is_stage_product(file_path, "05"):
        target = ("05-format-cleaned.md", ("format-cleaner", "next-chapter"))

    if target is None:
        return None

    product_name, allowed_states = target

    # P0/P1 检查（regardless of next_allowed）
    if p0 > 0 or p1 > 0:
        return make_deny(
            f"P0/P1 未清零（P0={p0}, P1={p1}），禁止写入 {product_name}。"
            f"必须先运行 reference-integrity-auditor 补齐证据，"
            f"审计通过并清零后方可进入下游阶段。详见 workflow §审计退回修复闭环。"
        )

    # next_allowed 阶段匹配检查
    if na not in allowed_states:
        return make_deny(
            f"当前 next_allowed=\"{na}\"，不允许写入 {product_name}。"
            f"该产物要求 next_allowed 为 {' / '.join(allowed_states)}。"
            f"请确认上游阶段已完成并更新了 status.json。详见 workflow §强制串行规则。"
        )

    return None


def check_skip_stage_confirm(file_path: str, workflow_dir: Path, status: dict | None):
    """防线 3：跳阶段确认 — 缺少上游产物时要求用户确认。

    使用 ask（而非 deny），因为用户可能已直接指定写作范围。
    覆盖 workflow §强制串行规则 第 2、4 条（上游产物存在性检查）。
    """
    checks = [
        ("02", "02-chapter-draft.md", "01-outline.md",
         "thesis-outline-planner", "大纲规划"),
        ("03", "03-reference-audit.md", "02-chapter-draft.md",
         "evidence-grounded-chapter-writer", "章节写作"),
        ("04", "04-humanized.md", "03-reference-audit.md",
         "reference-integrity-auditor", "证据审计"),
        ("05", "05-format-cleaned.md", "03-reference-audit.md",
         "reference-integrity-auditor（及 engineering-paper-humanizer）", "审计与润色"),
    ]

    for stage, product, upstream, skill, desc in checks:
        if is_stage_product(file_path, stage) and not upstream_exists(workflow_dir, upstream):
            return make_ask(
                f"你正要写入 {product}，但 {upstream} 不存在。"
                f"请确认：是否已通过 {skill} 完成{desc}？"
                f"若用户已直接指定范围可继续；若未完成，建议先运行上游阶段以便证据追踪和后续审计。"
            )

    return None


def main():
    try:
        raw = sys.stdin.read()
        data = json.loads(raw)
    except (json.JSONDecodeError, OSError):
        print("{}")
        return

    tool_name = data.get("tool_name", "")
    if tool_name not in ("Write", "Edit", "MultiEdit"):
        print("{}")
        return

    tool_input = data.get("tool_input", {})
    file_path = tool_input.get("file_path", "") or ""
    if not file_path:
        print("{}")
        return

    workflow_dir = find_workflow_dir()
    if workflow_dir is None:
        print("{}")
        return

    status = read_status(workflow_dir)

    # 防线 1：主文件保护（deny — AI 可见 permissionDecisionReason）
    result = check_main_file_protection(file_path, workflow_dir, status)
    if result is not None:
        print(json.dumps(result, ensure_ascii=False))
        return

    # 防线 2：阶段门控（deny — AI 可见 permissionDecisionReason）
    result = check_stage_gate(file_path, workflow_dir, status)
    if result is not None:
        print(json.dumps(result, ensure_ascii=False))
        return

    # 防线 3：跳阶段确认（ask — AI 和用户均可见 permissionDecisionReason）
    result = check_skip_stage_confirm(file_path, workflow_dir, status)
    if result is not None:
        print(json.dumps(result, ensure_ascii=False))
        return

    print("{}")


if __name__ == "__main__":
    main()
